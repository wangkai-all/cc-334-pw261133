{
  "manifest_version": 3,
  "name": "Report Portal Download Collector",
  "version": "1.0.0",
  "description": "Correlates report downloads by task id + token + content hash, never by filename.",
  "permissions": ["downloads", "storage", "alarms"],
  "host_permissions": [
    "http://127.0.0.1:8080/*",
    "http://localhost:8080/*",
    "http://127.0.0.1:8090/*",
    "http://localhost:8090/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Report Collector"
  },
  "icons": {}
}
